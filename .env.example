# Copy to .env and fill in from Supabase (Project Settings -> API).
# See SUPABASE.md. With these unset the game saves to this browser only.
#
# The `anon` key is public by design and safe in a browser bundle.
# The `service_role` key is NOT - it bypasses every row-level rule.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
