{
  "name": "meadow-route",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node tools/check.mjs && node tools/play.mjs",
    "play": "node tools/play.mjs",
    "tradedb": "node tools/tradedb.mjs",
    "admin": "npm --prefix admin run dev",
    "admin:build": "npm --prefix admin run build",
    "assets": "node tools/fetch-species.mjs && node tools/fetch-items.mjs && node tools/fetch-evolutions.mjs && python tools/build_origin.py",
    "forms": "node tools/fetch-forms.mjs && node tools/fetch-evolutions.mjs",
    "eventart": "python tools/build_event_sprites.py",
    "kits": "node tools/build_kits.mjs",
    "arenas": "python tools/build_arenas.py",
    "pmd": "python tools/build_pmd.py",
    "intro": "python tools/build_arena_intro.py",
    "fx": "python tools/build_fx.py",
    "art": "python tools/build_assets.py",
    "map": "python tools/build_map.py",
    "layout": "python tools/study_layout.py",
    "shape": "python tools/study_shape.py",
    "tilesets": "python tools/fetch_tilesets.py",
    "leagues": "node tools/fetch-leagues.mjs",
    "moves": "node tools/fetch-moves.mjs",
    "battleart": "python tools/build_battle_art.py",
    "gyms": "node tools/tune-gyms.mjs",
    "edge": "node tools/build-edge.mjs",
    "anchors": "node tools/rank-anchors.mjs",
    "ranks": "python tools/build_ranks.py",
    "anims": "python tools/build_anims.py",
    "follow": "python tools/build_follow.py",
    "skins": "python tools/build_skins.py",
    "abilities": "node tools/fetch-abilities.mjs",
    "genders": "node tools/fetch-genders.mjs",
    "cadence": "python tools/build_cadence.py",
    "cards": "node tools/fetch-cards.mjs && python tools/fetch_card_art.py",
    "prices": "node tools/fetch-prices.mjs",
    "retro": "python tools/build_retro.py",
    "promos": "python tools/fetch_promo_cards.py",
    "drift": "python tools/build_event_drift.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "@vercel/analytics": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "pg": "^8.23.0",
    "vite": "^5.4.11"
  }
}
